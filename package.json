{
  "name": "pcwe2026-fansite",
  "version": "0.1.0",
  "private": true,
  "description": "PODCAST EXPO 2026 非公式ファンガイドサイト",
  "scripts": {
    "dev": "tsx scripts/build-sw.ts && next dev -p ${PORT:-3015}",
    "prebuild": "tsx scripts/build-programs.ts && tsx scripts/build-sw.ts",
    "build": "next build",
    "build-sw": "tsx scripts/build-sw.ts",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "validate-data": "tsx scripts/validate-data.ts",
    "list-booths": "tsx scripts/list-booths.ts",
    "fetch:official": "tsx scripts/fetch-booth-info.ts",
    "build:programs": "tsx scripts/build-programs.ts",
    "download-thumbnails": "tsx scripts/download-thumbnails.ts",
    "assign-fan-guide": "tsx scripts/assign-fan-guide.ts",
    "fan-guide-status": "tsx scripts/fan-guide-status.ts"
  },
  "dependencies": {
    "fuse.js": "^7.0.0",
    "lucide-react": "^0.487.0",
    "next": "^15.5.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "cheerio": "^1.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
